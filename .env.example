# Copy to .env.local and fill in. Never commit real values.

# --- ElevenLabs (auctioneer voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=jv41DhCf464zw0TI7I1w   # "Imogen" from the Voice Library

# --- Arc testnet contracts (already deployed — use as-is) ---
ESCROW_ADDRESS=0xB1e11FCF92439A0F71daaefCC4B51c276210Ea45
RECEIPT_NFT_ADDRESS=0x050c0DDd11dDc5D68b403F18922240e0DEeCe15C

# --- House treasury / auctioneer: settles lots, receives fees, funds grants ---
# Must be the escrow's auctioneer key for settlement to work.
FEE_SELLER_PRIVATE_KEY=0x...
FEE_RECIPIENT_ADDRESS=0x...

# --- House agents (the rivals): JSON map of agent id (lowercase address) -> private key ---
AGENT_KEYS={"0x...":"0x..."}

# --- Secrets for user agents and sessions (generate: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))") ---
AGENT_MASTER_SEED=0x...   # derives every user agent's wallet — back it up
SESSION_SECRET=           # 32+ random characters

# --- Optional ---
# AUCTION_START_DELAY_MS=45000   # first auction after boot
# AUCTION_GAP_MINUTES=5          # intermission between auctions (min 0.5)
# AUCTION_ITEMS=3                # lots per auction
# COMMENDA_DB_PATH=./cache/commenda.db
# VOICE_KILL_SWITCH=1            # mute TTS generation (cache still plays)
# DRY_RUN=1                      # exercise voice without spending credits
